              ]
            },
            {
              "abilityId": "english_g1_listening_classroom_words",
              "title": "课堂词句听辨",
              "category": "listening",
              "behaviors": [
                {
                  "behaviorId": "english_g1_listening_classroom_words_follow_instruction",
                  "title": "能听懂常见课堂指令",
                  "evidenceExamples": ["听到 open your book 没反应"]
                },
                {
                  "behaviorId": "english_g1_listening_classroom_words_identify_common",
                  "title": "能听辨常见实物和颜色词",
                  "evidenceExamples": ["听到 red/blue 反应慢"]
                }
              ]
            }
          ]
        },
        {
          "domainId": "english_g1_speaking_vocabulary",
          "title": "基础表达与词汇",
          "abilities": [
            {
              "abilityId": "english_g1_speaking_greetings",
              "title": "问候与自我介绍",
              "category": "speaking",
              "behaviors": [
                {
