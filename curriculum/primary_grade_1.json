                },
                {
                  "behaviorId": "english_g1_speaking_greetings_name",
                  "title": "能用简单句说出自己的名字",
                  "evidenceExamples": ["My name is 句式不会说"]
                }
              ]
            },
            {
              "abilityId": "english_g1_vocabulary_common_topics",
              "title": "常见主题词汇",
              "category": "vocabulary",
              "behaviors": [
                {
                  "behaviorId": "english_g1_vocabulary_common_topics_family_school",
                  "title": "能认读家庭、学校等常见主题词",
                  "evidenceExamples": ["family、school 等词隔天就忘"]
                },
                {
                  "behaviorId": "english_g1_vocabulary_common_topics_match_picture",
                  "title": "能把常见单词和图片对应起来",
                  "evidenceExamples": ["看到图片不知道对应单词"]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
